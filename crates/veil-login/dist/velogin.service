# Velogin login manager (veil-login)
#
# Source-install paths (dist/install.sh): /usr/local/bin/velogin and this file
# in /etc/systemd/system. A package install uses /usr/bin and
# /usr/lib/systemd/system instead; don't mix the two (the /etc copy would
# shadow the packaged unit after an upgrade).
#
# Full install (needs root):
#   install -Dm644 dist/pam.d/velogin /etc/pam.d/velogin
#   install -Dm644 dist/velogin.service /etc/systemd/system/velogin.service
#   install -Dm755 target/release/velogin /usr/local/bin/velogin
#   systemctl disable getty@tty1.service
#   systemctl enable velogin.service
#
# Restart=always is load-bearing: velogin exits after each session ends
# (one login per process life), and systemd respawning it IS the
# return-to-greeter loop.
#
# The VT is whatever TTYPath points at: velogin derives it from its own stdin
# tty (no XDG_VTNR needed). To run on another VT, change TTYPath here and the
# getty@ttyN name in Conflicts/After.

[Unit]
Description=Velogin login manager (veil-login)
Conflicts=getty@tty1.service
After=systemd-user-sessions.service getty@tty1.service plymouth-quit-wait.service
After=systemd-logind.service
Wants=systemd-logind.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/bin/velogin
Restart=always
RestartSec=1
Environment=XDG_SEAT=seat0
Environment=LIBSEAT_BACKEND=logind
SupplementaryGroups=video input render
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
Alias=display-manager.service
